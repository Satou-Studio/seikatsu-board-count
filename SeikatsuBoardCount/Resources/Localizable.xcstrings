{
  "sourceLanguage" : "ja",
  "strings" : {
    "support.emailAddress" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "お問い合わせのメールアドレス" } } } },
    "support.title" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "保護者の方へ" } } } },
    "support.introduction" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "使い方の確認や、ご意見・感想を届けるための画面です。どの入口も任意で利用できます。" } } } },
    "support.help" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "使い方・お問い合わせ" } } } },
    "support.webDetail" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "ブラウザでサポートページを開きます。" } } } },
    "support.mail" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "ご意見をメールで送る" } } } },
    "support.mailDetail" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "メールの下書きを開きます。送信するかはご自身で決められます。" } } } },
    "support.review" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "App Storeでレビューを書く" } } } },
    "support.reviewDetail" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "App Storeのレビュー画面を開きます。率直な感想をお寄せください。" } } } },
    "support.contact" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "連絡先とお願い" } } } },
    "support.privacy" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "お子さまの名前・写真・実際の記録など、個人情報は送らないでください。" } } } },
    "support.manualSending" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "記録データや端末情報は自動で添付・送信しません。メール送信やレビュー投稿は、ご自身の操作で行います。" } } } },
    "support.close" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "閉じる" } } } },
    "support.mailUnavailable" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "この端末ではメールの下書きを開けません。お使いのメールアプリで、以下の宛先と記入例を利用できます。各項目の記入は任意です。" } } } },
    "support.mailSubject" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "生活ボードカウントへのご意見" } } } },
    "support.mailBody" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "以下の項目は任意です。書ける範囲でお聞かせください。\nお子さまの名前・写真・実際の記録など、個人情報は送らないでください。\n\n【どんな場面で使っているか】\n\n\n【どこで迷ったか・困ったか】\n\n\n【要望・感想】\n\n" } } } },
    "support.linkFailed" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "リンクを開けませんでした" } } } },
    "support.linkFailedDetail" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "端末の利用制限などを確認してください。お問い合わせの宛先は、この画面で確認できます。" } } } },
    "recovery.title" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "記録を読み込めませんでした" } } } },
    "recovery.explanation" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "元のデータを守るため、記録の追加や変更を止めています。元のデータは上書きしていません。" } } } },
    "recovery.options" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "再読み込みしても変わらない場合は、元データの控えをこの端末に残し、空の状態から始めることができます。控えから記録を元どおりに戻せるとは限りません。アプリを削除すると控えも消えるため、削除しないでください。" } } } },
    "recovery.retry" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "もう一度読み込む" } } } },
    "recovery.startOver" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "空の状態から始める…" } } } },
    "recovery.confirmTitle" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "これまでの項目と記録を使わずに始めますか？" } } } },
    "recovery.confirmMessage" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "元データの控えをこの端末に保存してから、新しい記録を始めます。以前の記録は表示されなくなります。控えを保存できない場合は初期化しません。控えから自動で復元する機能はありません。" } } } },
    "recovery.confirm" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "控えを残して始める" } } } },
    "recovery.cancel" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "キャンセル" } } } },
    "recovery.backupFailed" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "控えを保存できなかったため、初期化していません。元のデータはそのままです。端末の空き容量などを確認してください。" } } } }
  },
  "version" : "1.0"
}
